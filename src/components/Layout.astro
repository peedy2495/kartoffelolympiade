---
// Shared layout: header, centered main (max 1320px), theme toggle, footer.
import "../styles/global.css";

interface Props {
  title: string;
  noReferrer?: boolean;
  noindex?: boolean;
}
const { title, noReferrer = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content="Kartoffelolympiade – Wertung für das Kartoffelfeuer." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Kartoffelolympiade</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("ko-theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (saved === "dark" || (!saved && systemDark)) {
          document.documentElement.classList.add("dark");
        }
      } catch {}
      try {
        const btn = document.getElementById("ko-theme-toggle");
        const dark = document.documentElement.classList.contains("dark");
        if (btn) {
          btn.setAttribute("aria-label", dark ? "Zum hellen Modus wechseln" : "Zum dunklen Modus wechseln");
          btn.setAttribute("title", dark ? "Zum hellen Modus wechseln" : "Zum dunklen Modus wechseln");
          btn.innerHTML = dark
            ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'
            : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b" style="border-color: var(--ko-line); background: var(--ko-surface)">
      <div class="mx-auto flex max-w-[1320px] items-center gap-3 px-4 py-3">
        <img src="/favicon.svg" alt="" width="32" height="32" aria-hidden="true" />
        <a href="/" class="text-lg font-bold tracking-tight">Kartoffelolympiade</a>
        <nav class="ml-auto flex items-center gap-2" aria-label="Hauptnavigation">
          <button id="ko-theme-toggle" class="ko-btn ko-theme-toggle" type="button" aria-label="Zum dunklen Modus wechseln" title="Zum dunklen Modus wechseln">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-[1320px] px-4 py-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-[1320px] px-4 pb-8">
      <p class="ko-hint">Kartoffelolympiade · zentrale Wertung.</p>
    </footer>
    <script is:inline>
      document.getElementById("ko-theme-toggle")?.addEventListener("click", () => {
        const el = document.documentElement;
        el.classList.toggle("dark");
        const dark = el.classList.contains("dark");
        try {
          localStorage.setItem("ko-theme", dark ? "dark" : "light");
        } catch {}
        const btn = document.getElementById("ko-theme-toggle");
        if (btn) {
          btn.setAttribute("aria-label", dark ? "Zum hellen Modus wechseln" : "Zum dunklen Modus wechseln");
          btn.setAttribute("title", dark ? "Zum hellen Modus wechseln" : "Zum dunklen Modus wechseln");
          btn.innerHTML = dark
            ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'
            : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
        }
      });
    </script>
  </body>
</html>
