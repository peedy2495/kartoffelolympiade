# Copy to .env.development.local (dev) or configure as Vercel environment variables (prod).
# Values are placeholders only — never commit real credentials.
TURSO_DATABASE_URL=libsql://example.turso.io
TURSO_AUTH_TOKEN=example-token
# Optional custom domain for trusted-host handling (build time): explicit
# absolute http(s) origin, e.g. APP_ORIGIN=https://spiele.example.de.
# Plain hostnames, paths, query strings and wildcards are ignored.
#APP_ORIGIN=https://spiele.example.de
